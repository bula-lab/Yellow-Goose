{
    "name": "yellow-goose/demo",
    "description": "Yellow-Goose demonstration application",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "yellow-goose/framework": "@dev"
    },
    "suggest": {
        "ext-pdo_mysql": "For MySQL connections"
    },
    "scripts": {
        "test": "php tests/contracts.php && php tests/run.php && php tests/navigation.php && php tests/modules.php && php tests/integration-foundation.php && php tests/b1.php && php tests/b2.php && php tests/c1.php && php tests/d1.php"
    },
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/php/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/framework",
            "options": {
                "symlink": true,
                "versions": {
                    "yellow-goose/framework": "dev-main"
                }
            }
        }
    ],
    "require-dev": {
        "yellow-goose/resources": "^0.2",
        "yellow-goose/validator-symfony": "^0.2",
        "yellow-goose/jobs": "^0.2",
        "yellow-goose/assets": "^0.2",
        "yellow-goose/cms": "^0.2",
        "yellow-goose/scene-api": "^0.2",
        "yellow-goose/game-strategy": "^0.2"
    }
}
