{
    "name": "yellow-goose/demo",
    "description": "Yellow-Goose demonstration application",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "yellow-goose/framework": "@dev"
    },
    "suggest": {
        "ext-pdo_mysql": "For MySQL connections"
    },
    "scripts": {
        "test": "php tests/run.php && php tests/navigation.php"
    },
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/framework",
            "options": {
                "symlink": true,
                "versions": {
                    "yellow-goose/framework": "dev-main"
                }
            }
        }
    ]
}
