{
  "name": "zolta-gaska-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "php gaska dev",
    "build": "npm run build:client && npm run build:ssr",
    "test": "composer test",
    "test:e2e": "python3 tests/e2e.py",
    "demo": "php gaska db:migrate && php gaska db:seed && npm run build && php gaska serve",
    "test:http": "python3 tests/cgi.py",
    "dev:vite": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr app/server.jsx",
    "test:runtime": "node --test tests/*.test.mjs && php tests/ssr.php",
    "test:package": "python3 tests/package.py",
    "verify": "npm run check:packages && npm test && npm run test:modules && npm run test:binary && npm run build && npm run build:garage && npm run build:scene && npm run test:runtime && npm run test:http && npm run test:package && npm run test:garage:http && npm run test:product:packages && npm run test:scene:http && npm run test:scene:packages",
    "verify:all": "npm run verify && npm run test:e2e && npm run test:product:browser && npm run test:scene:browser",
    "sync:legacy": "node scripts/sync-legacy.mjs",
    "check:packages": "python3 scripts/check-packages.py && node scripts/sync-legacy.mjs --check",
    "test:modules": "python3 tests/modules-cgi.py && python3 tests/migrations.py",
    "build:garage": "npm run build --prefix examples/garage-cms",
    "build:scene": "npm run build --prefix examples/scene-editor",
    "test:binary": "python3 tests/integration-request.py",
    "test:garage:http": "python3 tests/b2-http.py",
    "test:product:packages": "python3 tests/integration-packages.py --minimal-runtime",
    "test:product:browser": "python3 tests/b1-browser.py && python3 tests/b2-browser.py",
    "test:scene:http": "python3 tests/c1-http.py",
    "test:scene:packages": "python3 tests/c1-packages.py --minimal-runtime",
    "test:scene:browser": "python3 tests/c1-browser.py && python3 tests/fixtures/c1/gesture-browser.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "@yellow-goose/babylon": "file:packages/js/babylon",
    "@yellow-goose/editor": "file:packages/js/editor",
    "@yellow-goose/react": "file:packages/js/react",
    "@yellow-goose/scene": "file:packages/js/scene",
    "@yellow-goose/ui": "file:packages/js/ui",
    "@yellow-goose/vite": "file:packages/js/vite",
    "vite": "8.3.8"
  }
}
