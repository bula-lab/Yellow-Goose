{
    "name": "yellow-goose/framework",
    "description": "PHP file routing, loaders, database and React SSR runtime",
    "type": "library",
    "autoload": {
        "psr-4": {
            "ZoltaGaska\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "yellow-goose/core": "^0.2",
        "yellow-goose/database": "^0.2",
        "yellow-goose/react-bridge": "^0.2",
        "yellow-goose/ssr-v8js": "^0.2",
        "yellow-goose/security": "^0.2"
    },
    "suggest": {
        "ext-v8js": "React SSR inside PHP without Node.js on the server",
        "ext-pdo_sqlite": "SQLite database support",
        "ext-pdo_mysql": "MySQL database support"
    },
    "bin": [
        "bin/gaska"
    ]
}
